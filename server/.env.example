# Server Environment Configuration Placeholder
# Note: Port 5001 is used by default because macOS uses port 5000 for AirPlay Receiver
PORT=5001
NODE_ENV=development

# Frontend Client URL (for CORS)
CLIENT_URL=http://localhost:5173

# Database Connection (PostgreSQL with Prisma)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/alumni_connect?schema=public

# Authentication (JWT)
JWT_SECRET=your_jwt_secret_key_change_in_production
JWT_EXPIRES_IN=7d
