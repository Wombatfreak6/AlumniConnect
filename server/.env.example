# Server Environment Configuration
PORT=5001
NODE_ENV=development

# Frontend Client URL (for CORS)
CLIENT_URL=http://localhost:5173

# Database Connection (PostgreSQL with Prisma 7)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
# Examples:
#   macOS (Homebrew default): postgresql://$(whoami)@localhost:5432/alumni_connect?schema=public
#   Standard local Postgres:  postgresql://postgres:postgres@localhost:5432/alumni_connect?schema=public
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/alumni_connect?schema=public"
# Optional integration test database; keep its database name ending in _test.
TEST_DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/alumni_connect_test?schema=public"

# Authentication (JWT)
JWT_SECRET=generate-a-unique-random-secret-with-at-least-32-characters
JWT_EXPIRES_IN=7d

# Initial Administrator Seed Credentials
ADMIN_EMAIL=admin@alumniconnect.edu
ADMIN_PASSWORD=replace-with-a-unique-strong-password

# Optional email delivery for notification messages (SMTP credentials required)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

