# Server Environment Configuration
PORT=5001
NODE_ENV=development

# Frontend Client URL (for CORS)
CLIENT_URL=http://localhost:5173

# Database Connection (PostgreSQL with Prisma 7)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
# Examples:
#   macOS (Homebrew default): postgresql://$(whoami)@localhost:5432/alumni_connect?schema=public
#   Standard local Postgres:  postgresql://postgres:postgres@localhost:5432/alumni_connect?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/alumni_connect?schema=public"

# Authentication (JWT)
JWT_SECRET=your_jwt_secret_key_change_in_production
JWT_EXPIRES_IN=7d

# Initial Administrator Seed Credentials
ADMIN_EMAIL=admin@alumniconnect.edu
ADMIN_PASSWORD=Admin@Secure2026!

